generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model UserApiLimit {
  id String @id @default(cuid())
  userId String @unique
  count Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSubscription {
  id String @id @default(cuid())
  userId String @unique
  paddleCustomerId String? @unique @map(name: "paddle_customer_id")
  paddleSubscriptionId String? @unique @map(name: "paddle_subscription_id")
  paddlePriceId String? @map(name: "paddle_price_id")
  paddleStatus String? @map(name: "paddle_status")
  paddleCurrentPeriodEnd DateTime? @map(name: "paddle_current_period_end")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}